  "scripts": {
    "android:run:dev": "run-s android:adb:reverse && EXPO_PACKAGER_PROXY_URL=http://localhost:8081 expo run:android",
    "android:run:release": "APP_VARIANT=production run-s android:gradle:stop android:prebuild android:build:release android:gradle:stop && run-s android:prebuild",
    "android:start:dev": "run-s android:adb:reverse && EXPO_PACKAGER_PROXY_URL=http://localhost:8081 expo start --android",
    "android:adb:reverse": "$ANDROID_HOME/platform-tools/adb reverse tcp:8081 tcp:8081",
    "android:gradle:stop": "node -e \"require('fs').existsSync('android') && require('child_process').execSync(process.platform === 'win32' ? 'gradlew.bat --stop' : './gradlew --stop', { cwd: 'android', stdio: 'inherit' })\"",
    "android:prebuild": "expo prebuild --clean --platform android",
    "android:build:release": "expo run:android --variant release --no-bundler",
    "ios:start:dev": "expo start --ios",
    "start": "expo start",
    "prebuild:clean": "expo prebuild --clean",
    ...
    "test:e2e": "node -e \"require('fs').rmSync('maestro-output',{recursive:true,force:true})\" && maestro test .maestro --debug-output maestro-output --flatten-debug-output",
    ...
  },
